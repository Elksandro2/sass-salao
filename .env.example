# ──────────────────────────────────────────────────────────────────────────────
# Banco de Dados (PostgreSQL)
# Localmente: docker compose up -d db  →  porta exposta em 5433
# ──────────────────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5433/salon_dev
DB_USER=salon
DB_PASS=salon
DB_PASSWORD=salon

# ──────────────────────────────────────────────────────────────────────────────
# Autenticação JWT
# Gere um valor seguro para produção: openssl rand -hex 64
# ──────────────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-must-be-at-least-256-bits-long-use-openssl-rand

# ──────────────────────────────────────────────────────────────────────────────
# E-mail (Resend)
# https://resend.com/api-keys
# ──────────────────────────────────────────────────────────────────────────────
MAIL_API_URL=https://api.resend.com/
MAIL_PASSWORD=re_your_api_key_here
MAIL_FROM=noreply@yourdomain.com
MAIL_BUSINESS=your_business_email@example.com

# ──────────────────────────────────────────────────────────────────────────────
# URL do frontend — usada para montar links clicáveis em e-mails (ex.: redefinição
# de senha, notificação de novo agendamento pro painel).
#
# EM PRODUÇÃO, troque esta linha no .env do servidor (não aqui):
#   FRONTEND_URL=https://eq03.dsc.rodrigor.com
# ──────────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ──────────────────────────────────────────────────────────────────────────────
# Pagamentos (Mercado Pago)
# Tokens de teste começam com TEST-  |  Produção: APP_USR-
# https://www.mercadopago.com.br/developers/panel/app
# ──────────────────────────────────────────────────────────────────────────────
MERCADO_PAGO_ACCESS_TOKEN=TEST-your-mp-access-token-here
MERCADO_PAGO_WEBHOOK_SECRET=your-mp-webhook-secret-here

# Split de pagamento (marketplace): permite dividir o PIX entre o salão e a funcionária que
# atendeu. Client ID/Secret só existem nas credenciais de PRODUÇÃO do app no painel do MP
# (Marketplace/Split precisa ser habilitado na aplicação). O redirect URI precisa ser
# HTTPS e estar cadastrado exatamente igual no painel do app.
MERCADO_PAGO_CLIENT_ID=your-mp-client-id-here
MERCADO_PAGO_CLIENT_SECRET=your-mp-client-secret-here
MERCADO_PAGO_OAUTH_REDIRECT_URI=https://your-domain.com/v1/employees/mercadopago/callback
# Taxa aproximada cobrada pelo MP no PIX, usada só pra calcular o split (default 0.99%)
MERCADO_PAGO_PIX_FEE_RATE=0.0099

# ──────────────────────────────────────────────────────────────────────────────
# Central de IA (recomendações + servidor MCP)
# Chave AES-256 em base64 que cifra a API key de IA salva pelo Sysadmin em tb_ai_config.
# Gere com: python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# A API key do provedor (LiteLLM) em si NÃO vai aqui — é configurada pela tela de Sysadmin.
# ──────────────────────────────────────────────────────────────────────────────
AI_CONFIG_ENCRYPTION_KEY=change-me-generate-a-real-base64-32-byte-key-for-production

# ──────────────────────────────────────────────────────────────────────────────
# Dados pessoais sensíveis da equipe (CPF e chave PIX em tb_staff_profile)
# Chaves SEPARADAS da chave de IA de propósito: comprometer uma não compromete a outra.
# Gere cada uma com: python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
#
# ATENÇÃO: se estas chaves forem perdidas, os CPFs e chaves PIX já cifrados ficam
# irrecuperáveis. Se forem trocadas, é preciso re-cifrar os dados existentes.
# ──────────────────────────────────────────────────────────────────────────────
APP_PII_ENCRYPTION_KEY=change-me-generate-a-real-base64-32-byte-key-for-production
APP_PII_HASH_PEPPER=change-me-generate-a-different-base64-32-byte-key-for-production

# ──────────────────────────────────────────────────────────────────────────────
# Notificações Push (Web Push API)
# Gere UMA VEZ com: cd salon-front && npx web-push generate-vapid-keys
#
# ATENÇÃO CRÍTICA: nunca regenere a chave privada em produção depois de gerada.
# Trocar a chave invalida TODAS as subscriptions de push já salvas no banco —
# todo usuário precisaria autorizar notificações de novo. Gere uma vez, guarde
# num lugar seguro (gerenciador de senhas da equipe), e não mude mais.
#
# EM PRODUÇÃO, troque estas linhas no .env do servidor (não aqui):
#   VAPID_PUBLIC_KEY=<gerado uma vez, nunca mude>
#   VAPID_PRIVATE_KEY=<gerado uma vez, nunca mude>
#   VAPID_SUBJECT=mailto:seu-contato-real@dominio.com
#
# ATENÇÃO — a chave do FRONTEND *não* vai no .env do servidor. Em produção o React é
# compilado dentro do Dockerfile, e o Vite embute as variáveis VITE_* no bundle nesse
# momento; o .env do servidor só é lido depois, quando o container sobe, tarde demais.
# Configure a MESMA chave pública como variável de repositório no GitHub:
#   Settings → Secrets and variables → Actions → Variables → VITE_VAPID_PUBLIC_KEY
# (o cd.yml a repassa como build-arg). Sem isso o navegador nunca pede permissão de
# notificação e nenhuma subscription é criada — só os e-mails chegam.
# Localmente com `npm run dev`, use salon-front/.env. Localmente com
# `docker compose up --build` (imagem única backend+frontend), defina VITE_VAPID_PUBLIC_KEY
# aqui mesmo — o docker-compose.yml repassa como build-arg pro Dockerfile.
# ──────────────────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=change-me-generate-with-npx-web-push-generate-vapid-keys
VAPID_PRIVATE_KEY=change-me-generate-with-npx-web-push-generate-vapid-keys
VAPID_SUBJECT=mailto:admin@salao.com
VITE_VAPID_PUBLIC_KEY=change-me-same-value-as-VAPID_PUBLIC_KEY-above

# ──────────────────────────────────────────────────────────────────────────────
# Observabilidade (OpenTelemetry)
# Config de DEV LOCAL: aponta para o container otel-lgtm subido pelo próprio
# docker-compose.yml (Grafana local em http://localhost:3000, sem autenticação).
#
# EM PRODUÇÃO, troque estas duas linhas no .env do servidor (não aqui):
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.dsc.rodrigor.com
#   OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token-da-turma>
# (token da turma: peça no canal da disciplina — NUNCA commite o valor real)
# OTEL_SERVICE_NAME, OTEL_EXPORTER_OTLP_PROTOCOL e OTEL_LOGS_EXPORTER não mudam entre os ambientes.
# ──────────────────────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=dsc-eq03
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_LOGS_EXPORTER=otlp
# Sem isso, o agente captura o log mas ignora qualquer campo custom do MDC (ex.: relatorio.periodo)
OTEL_INSTRUMENTATION_LOGBACK_APPENDER_EXPERIMENTAL_CAPTURE_MDC_ATTRIBUTES=*

# ──────────────────────────────────────────────────────────────────────────────
# Frontend (Vite)
# ──────────────────────────────────────────────────────────────────────────────
VITE_API_URL=/v1

# ──────────────────────────────────────────────────────────────────────────────
# CORS (produção — deixe vazio para usar o padrão do application.yaml)
# ──────────────────────────────────────────────────────────────────────────────
APP_CORS_ALLOWED_ORIGINS=

# ──────────────────────────────────────────────────────────────────────────────
# Testes de Carga (k6)
# BASE_URL aponta para onde o backend está rodando durante o teste
# ──────────────────────────────────────────────────────────────────────────────
BASE_URL=http://localhost
ADMIN_EMAIL=sysadmin@salao.com
ADMIN_PASSWORD=your-sysadmin-password-here